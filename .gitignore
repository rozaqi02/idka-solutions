# ==========================================
# IDKA Solutions - Master .gitignore
# Aman untuk Netlify deployment (hanya menahan file lokal/temporary/sensitif)
# ==========================================

# ===== 1. Build Outputs & Dependencies =====
# Netlify akan menginstall npm packages & membuat folder dist secara otomatis saat build.
node_modules/
dist/
dist-ssr/
build/
.vite/
.turbo/
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/
*.tsbuildinfo

# ===== 2. Environment Variables & Secrets =====
# Variabel rahasia lokal. Di Netlify, gunakan Environment Variables pada dashboard Netlify Site Settings.
.env
.env.*
!.env.example

# ===== 3. Root Screenshots & Raw Design Dumps =====
# File gambar mentah/screenshot lokal di root (misal screenshot referensi 17MB) agar tidak memberatkan repo.
/*.png
/*.jpg
/*.jpeg
/*.webp
business.apple.com_.png

# ===== 4. Temporary Files, Logs & Exports =====
# Log & file sementara tidak dibutuhkan saat runtime Netlify.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
.tmp/
.temp/
screenshots-tmp/
screenshots/
*.crdownload
*.partial
* - Copy.*
* (1).*

# ===== 5. Hosting & Deploy Local Caches =====
.netlify/
.vercel/
.firebase/
*.deploy-cache

# ===== 6. Package Manager Cache =====
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ===== 7. Editor & IDE Local Settings =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode/settings.local.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.tmp
*.temp
.history/
.fleet/

# ===== 8. OS Junk =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===== 9. AI Assistant & Agent Local State =====
# Log dan state lokal milik AI Agent / IDE.
.grok/
.kilo/
.kilocode/
.cursor/
.claude/
.codex/
.agent/
.agents/
.antigravity/

# ===== 10. Puppeteer & Browser Cache =====
.puppeteer_cache/
.chrome-profile/
chrome-user-data/
puppeteer-cache/

# ===== 11. Marketing Local Drafts & Generator Temp =====
# Asset final di public/ tetap ter-track & ter-deploy ke Netlify.
# Hanya file backup/draft/kerja lokal yang diabaikan.
public/marketing/**/bckaup/
public/marketing/**/backup/
public/marketing/**/*-old.*
public/marketing/**/*-backup.*
public/marketing/**/*-style-source.*
public/marketing/**/*-porto-real.*
public/marketing/**/*-original.*
public/marketing/**/*.draft.*
public/marketing/**/*.wip.*

# File referensi/generator internal team
public/team/team-grid-ref.png
public/team/team-grid-green.png
public/team/*-green.jpg
public/marketing/ig-posts/* - Copy.*

# Script HTML generator sekali pakai
scripts/ig-post-*.html

# ===== 12. Local Tooling Noise =====
*.stackdump
*.orig
*.rej